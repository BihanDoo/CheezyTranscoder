# All of these are optional. Everything except ADMIN_PASSWORD can also be
# changed later in the web UI at /settings (UI-saved values win).

# Password for /settings (user: admin). If unset, one is generated and
# printed in the container logs on first start (and stored in /data).
ADMIN_PASSWORD=

# Public domain used for download links, API examples and host enforcement.
# If unset, Coolify's injected COOLIFY_URL / COOLIFY_FQDN is used.
PUBLIC_URL=https://video.example.com
ENFORCE_DOMAIN=false
CORS_ORIGINS=

SITE_TITLE=CheezyTranscoder
API_KEY=
ALLOW_USER_OPTIONS=true
MAX_UPLOAD_MB=2048
FFMPEG_TIMEOUT=3600
MAX_CONCURRENT_JOBS=2
RETENTION_MINUTES=60
